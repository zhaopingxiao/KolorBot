{
  "name": "kolorbot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "KolorBot - a Node.js agent runtime with a web chat UI, sessions and MCP tools.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo": "pnpm build && pnpm --filter kolorbot-agent-loop demo",
    "demo:quickstart": "pnpm --filter kolorbot-agent-loop demo:quickstart",
    "web": "tsx --tsconfig tsconfig.dev.json packages/kolorbot-web/src/bin.ts run web",
    "gateway": "tsx --tsconfig tsconfig.dev.json packages/kolorbot-web/src/bin.ts run gateway",
    "scheduler": "tsx --tsconfig tsconfig.dev.json packages/kolorbot-web/src/bin.ts run scheduler",
    "web:dist": "pnpm build && node packages/kolorbot-web/dist/src/bin.js run web"
  },
  "dependencies": {
    "kolorbot-agent-loop": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}

{
  "name": "kolor-web",
  "version": "0.2.0",
  "description": "KolorBot Web: a local chat UI for KolorBot agents, with session storage and MCP management.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "kolor-web": "./dist/src/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "public",
    "README.md"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/bin.js"
  },
  "dependencies": {
    "kolor-agent-loop": "workspace:*",
    "kolor-sessions": "workspace:*",
    "kolor-skills": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
